post_install() {
  echo "Refreshing desktop database..."
  kbuildsycoca6 --noincremental 2>/dev/null || true
  update-desktop-database ~/.local/share/applications 2>/dev/null || true
}

post_upgrade() {
  post_install
}

post_remove() {
  echo "Cleaning up desktop database..."
  kbuildsycoca6 --noincremental 2>/dev/null || true
  update-desktop-database ~/.local/share/applications 2>/dev/null || true
}
