#!/usr/bin/env python3
"""ASUS PG32UCDM Pixel Cleaning GUI for Linux."""
import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Gtk, Adw, GLib
import subprocess
import threading
import time
import re

DDCUTIL = "ddcutil"
VCP_CODE = "0xfd"
CLEAN_ADD = 16
CLEAN_DURATION_SEC = 360

def run_ddcutil(args):
    try:
        result = subprocess.run(
            [DDCUTIL] + args,
            capture_output=True, text=True, timeout=30
        )
        return result.stdout.strip(), result.stderr.strip(), result.returncode
    except Exception as e:
        return "", str(e), 1

def parse_vcp_value(output):
    """Extract numeric cur_val from ddcutil getvcp manufacturer-specific output."""
    m = re.search(r"cur_val=(\d+)", output)
    if m:
        return int(m.group(1))
    # Manufacturer-specific codes return 4 bytes: mh, ml, sh, sl
    # Current value is (sh << 8) | sl
    mh = re.search(r"mh=0x([0-9a-fA-F]+)", output)
    ml = re.search(r"ml=0x([0-9a-fA-F]+)", output)
    sh = re.search(r"sh=0x([0-9a-fA-F]+)", output)
    sl = re.search(r"sl=0x([0-9a-fA-F]+)", output)
    if sh and sl:
        return (int(sh.group(1), 16) << 8) | int(sl.group(1), 16)
    return None

def get_current_value():
    out, err, rc = run_ddcutil(["getvcp", VCP_CODE])
    if rc != 0:
        return None, err
    val = parse_vcp_value(out)
    return val, out

class PixelCleanApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id="com.enterprise.pixelclean")
        self.current_value = None
        self.original_timeout = None
        self.cleaning = False

    def do_activate(self):
        win = Gtk.ApplicationWindow(application=self)
        win.set_title("PG32UCDM Pixel Clean")
        win.set_default_size(400, 250)

        # Header bar as titlebar for dragging
        header = Adw.HeaderBar()
        header.set_title_widget(Gtk.Label(label="Pixel Clean — ASUS PG32UCDM"))
        win.set_titlebar(header)

        # Main content
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.set_margin_top(24)
        box.set_margin_bottom(24)
        box.set_margin_start(24)
        box.set_margin_end(24)

        # Status label
        self.status_label = Gtk.Label(label="Detecting monitor…")
        self.status_label.set_wrap(True)
        self.status_label.set_justify(Gtk.Justification.CENTER)

        # Current value label
        self.value_label = Gtk.Label(label="")
        self.value_label.add_css_class("dim-label")

        # Progress bar (hidden initially)
        self.progress = Gtk.ProgressBar()
        self.progress.set_visible(False)
        self.progress.set_show_text(True)

        # Clean button
        self.clean_btn = Gtk.Button(label="Start Pixel Cleaning")
        self.clean_btn.add_css_class("suggested-action")
        self.clean_btn.set_halign(Gtk.Align.CENTER)
        self.clean_btn.connect("clicked", self.on_clean_clicked)

        box.append(self.status_label)
        box.append(self.value_label)
        box.append(self.progress)
        box.append(self.clean_btn)

        win.set_child(box)
        win.present()

        # Initial detection
        GLib.idle_add(self.detect_monitor)

    def detect_monitor(self):
        val, out = get_current_value()
        if val is None:
            self.status_label.set_label("❌ Could not read monitor VCP value.\nEnsure DDC/CI is enabled and ddcutil is installed.")
            self.clean_btn.set_sensitive(False)
            return False
        self.current_value = val
        self.status_label.set_label("✅ Monitor detected: ASUS PG32UCDM")
        self.value_label.set_label(f"Current 0xFD value: {val} (0x{val:04X})")
        self.clean_btn.set_sensitive(True)
        return False

    def on_clean_clicked(self, button):
        if self.cleaning:
            return
        self.cleaning = True
        button.set_sensitive(False)
        self.progress.set_visible(True)
        self.progress.set_fraction(0.0)
        self.progress.set_text("Preparing…")
        threading.Thread(target=self.run_cleaning, daemon=True).start()

    def run_cleaning(self):
        if self.current_value is None:
            GLib.idle_add(self.finish_cleaning, False, "No monitor value")
            return

        proposed = self.current_value + CLEAN_ADD
        GLib.idle_add(self.progress.set_text, f"Setting 0xFD to {proposed}…")

        # Set the pixel cleaning value without verification.
        # The monitor often goes offline during cleaning, which causes
        # ddcutil's default verify step to fail even though the write succeeded.
        out, err, rc = run_ddcutil(["setvcp", "--noverify", VCP_CODE, str(proposed)])
        if rc != 0:
            GLib.idle_add(self.finish_cleaning, False, f"Failed to start cleaning: {err}")
            return

        GLib.idle_add(self.progress.set_text, "Pixel cleaning in progress (~6 min)…")

        # Countdown for ~6 minutes
        steps = 60
        for i in range(steps):
            time.sleep(CLEAN_DURATION_SEC / steps)
            frac = (i + 1) / steps
            GLib.idle_add(self.progress.set_fraction, frac)

        # Wait for monitor to come back online before restoring
        GLib.idle_add(self.progress.set_text, "Waiting for monitor to reconnect…")
        for _ in range(30):  # wait up to 5 minutes
            val, _ = get_current_value()
            if val is not None:
                break
            time.sleep(10)
        else:
            GLib.idle_add(self.finish_cleaning, False, "Monitor did not reconnect after cleaning.")
            return

        # Restore original value
        GLib.idle_add(self.progress.set_text, "Restoring original value…")
        out, err, rc = run_ddcutil(["setvcp", VCP_CODE, str(self.current_value)])
        if rc != 0:
            GLib.idle_add(self.finish_cleaning, False, f"Failed to restore: {err}")
            return

        GLib.idle_add(self.finish_cleaning, True, "Pixel cleaning complete.")

    def finish_cleaning(self, success, message):
        self.cleaning = False
        self.clean_btn.set_sensitive(True)
        self.progress.set_fraction(1.0 if success else 0.0)
        self.progress.set_text(message)
        self.status_label.set_markup(
            f"<b>{'✅' if success else '❌'} {message}</b>"
        )
        # Refresh current value
        val, out = get_current_value()
        if val is not None:
            self.current_value = val
            self.value_label.set_label(f"Current 0xFD value: {val} (0x{val:04X})")
        return False

import sys
import traceback
import os

LOG_PATH = os.path.expanduser("~/.local/state/pixel-clean-gui.log")

def log_exception(exc_type, exc_value, exc_tb):
    with open(LOG_PATH, "a") as f:
        f.write("".join(traceback.format_exception(exc_type, exc_value, exc_tb))
        + "\n")
    sys.__excepthook__(exc_type, exc_value, exc_tb)

sys.excepthook = log_exception

app = PixelCleanApp()
app.run()
