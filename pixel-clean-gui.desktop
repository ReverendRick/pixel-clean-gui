[Desktop Entry]
Type=Application
Name=Pixel Clean (PG32UCDM)
Comment=ASUS ROG Swift OLED Pixel Cleaning
Exec=sh -c 'exec $HOME/.local/bin/pixel-clean-gui-launcher "$@"' -- %f
Icon=preferences-color
Terminal=false
Categories=Utility;Monitor;
StartupNotify=false
StartupWMClass=com.enterprise.pixelclean
OnlyShowIn=KDE;
